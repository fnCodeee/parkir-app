<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Edit Kendaraan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🅿️ Parkir Kampus Kelompok 4</a>
            <div>
                <a class="btn btn-outline-light me-2" href="/">Dashboard</a>
                <a class="btn btn-outline-light me-2" href="/masuk">Input Masuk</a>
                <a class="btn btn-outline-light me-2" href="/riwayat">Riwayat & Keluar</a>
                <a class="btn btn-outline-light" href="/pemilik">Data Pemilik</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4" style="max-width: 600px;">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0 text-dark">Edit Kendaraan — <%= item.no_plat %></h4>
            </div>
            <div class="card-body">
                <form action="/pemilik/edit/<%= item.id %>" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Plat Nomor</label>
                        <input type="text" name="no_plat" class="form-control" value="<%= item.no_plat %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nama Lengkap</label>
                        <input type="text" name="nama" class="form-control" value="<%= item.nama %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">NIM / NIP</label>
                        <input type="text" name="nim_nip" class="form-control" value="<%= item.nim_nip %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kategori Civitas</label>
                        <select name="kategori" class="form-select" required>
                            <% ['mahasiswa','dosen','staff'].forEach(k => { %>
                                <option value="<%= k %>" <%= item.kategori === k ? 'selected' : '' %>><%= k[0].toUpperCase() + k.slice(1) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Jenis Kendaraan</label>
                        <select name="id_jenis" class="form-select" required>
                            <option value="">-- Pilih Jenis --</option>
                            <% jenis.forEach(j => { %>
                                <option value="<%= j.id %>" <%= Number(item.id_jenis) === Number(j.id) ? 'selected' : '' %>>
                                    <%= j.nama %> (Rp <%= Number(j.tarif_per_jam).toLocaleString('id-ID') %>/jam)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-warning w-100">Simpan Perubahan</button>
                    <a href="/pemilik" class="btn btn-link w-100 mt-2">Batal</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
