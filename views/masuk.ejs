<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Input Kendaraan Masuk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Catat Kendaraan Masuk</h4>
            </div>
            <div class="card-body">
                <form action="/masuk" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Pilih Plat Nomor Kendaraan</label>
                        <select name="no_plat" class="form-select" required>
                            <option value="">-- Pilih Kendaraan Terdaftar --</option>
                            <% pemilik.forEach(p => { %>
                                <option value="<%= p.no_plat %>"><%= p.no_plat %> (<%= p.nama %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Pilih Area Parkir</label>
                        <select name="id_area" class="form-select" required>
                            <option value="">-- Pilih Zone Parkir --</option>
                            <% area.forEach(a => { %>
                                <option value="<%= a.id %>"><%= a.nama_area %></option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Proses Masuk Gerbang</button>
                    <a href="/" class="btn btn-link w-100 mt-2">Batal</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>