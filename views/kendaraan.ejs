<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Kelola Data Kendaraan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🅿️ Parkir Kampus Kelompok 4</a>
            <div>
                <a class="btn btn-outline-light me-2" href="/">Dashboard</a>
                <a class="btn btn-outline-light me-2" href="/masuk">Input Masuk</a>
                <a class="btn btn-outline-light me-2" href="/riwayat">Riwayat & Keluar</a>
                <a class="btn btn-outline-light" href="/pemilik">Data Pemilik</a>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Kelola Data Kendaraan</h2>
            <a href="#formTambah" class="btn btn-success">+ Tambah Kendaraan</a>
        </div>

        <!-- Form Tambah Data -->
        <div class="card shadow-sm mb-4" id="formTambah">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Form Tambah Kendaraan</h5>
            </div>
            <div class="card-body">
                <form action="/pemilik/tambah" method="POST">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Plat Nomor</label>
                                <input type="text" name="no_plat" class="form-control" placeholder="B 1234 XYZ" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Nama Lengkap</label>
                                <input type="text" name="nama" class="form-control" placeholder="Nama pemilik" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">NIM / NIP</label>
                                <input type="text" name="nim_nip" class="form-control" placeholder="NIM atau NIP" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Kategori Civitas</label>
                                <select name="kategori" class="form-select" required>
                                    <option value="mahasiswa">Mahasiswa</option>
                                    <option value="dosen">Dosen</option>
                                    <option value="staff">Staff</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Jenis Kendaraan</label>
                                <select name="id_jenis" class="form-select" required>
                                    <option value="">-- Pilih Jenis --</option>
                                    <% jenis.forEach(j => { %>
                                        <option value="<%= j.id %>"><%= j.nama %> (Rp <%= Number(j.tarif_per_jam).toLocaleString('id-ID') %>/jam)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">Simpan Kendaraan</button>
                </form>
            </div>
        </div>

        <!-- Tabel Daftar Kendaraan -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Daftar Kendaraan Terdaftar</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>No</th>
                                <th>ID</th>
                                <th>Plat Nomor</th>
                                <th>Nama Lengkap</th>
                                <th>NIM/NPM</th>
                                <th>Kategori Civitas</th>
                                <th>Jenis Kendaraan</th>
                                <th>Tarif Per Jam</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pemilik.forEach((p, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= p.id %></td>
                                    <td><strong><%= p.no_plat %></strong></td>
                                    <td><%= p.nama %></td>
                                    <td><%= p.nim_nip %></td>
                                    <td>
                                        <span class="badge bg-info text-uppercase"><%= p.kategori %></span>
                                    </td>
                                    <td><%= p.nama_jenis ? p.nama_jenis : '-' %></td>
                                    <td><%= p.tarif_per_jam ? 'Rp ' + Number(p.tarif_per_jam).toLocaleString('id-ID') : '-' %></td>
                                    <td class="text-nowrap">
                                        <a href="/pemilik/edit/<%= p.id %>" class="btn btn-sm btn-warning">Edit</a>
                                        <form action="/pemilik/hapus/<%= p.id %>" method="POST"
                                              onsubmit="return confirm('Hapus data <%= p.no_plat %> milik <%= p.nama %>?');"
                                              class="d-inline" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <% if (pemilik.length === 0) { %>
            <div class="alert alert-warning mt-3">Belum ada data kendaraan terdaftar. Silakan tambah menggunakan form di atas.</div>
        <% } %>
    </div>
</body>
</html>
