<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Riwayat Transaksi Parkir</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🅿️ Parkir Kampus Kelompok 4</a>
            <div>
                <a class="btn btn-outline-light me-2" href="/">Dashboard</a>
                <a class="btn btn-outline-light me-2" href="/masuk">Input Masuk</a>
                <a class="btn btn-outline-light me-2" href="/riwayat">Riwayat & Keluar</a>
                <a class="btn btn-outline-light" href="/pemilik">Data Pemilik</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2>Riwayat Parkir & Pencarian</h2>
        <!-- Form Pencarian Plat Nomor -->
        <form action="/riwayat" method="GET" class="row g-2 mb-4">
            <div class="col-auto">
                <input type="text" name="search" class="form-control" placeholder="Cari Plat Nomor..." value="<%= searchPlat %>">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Cari Plat</button>
                <a href="/riwayat" class="btn btn-secondary">Reset</a>
            </div>
        </form>

        <table class="table table-bordered bg-white shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Plat Nomor</th>
                    <th>Pemilik</th>
                    <th>Kategori</th>
                    <th>Jenis</th>
                    <th>Area</th>
                    <th>Waktu Masuk</th>
                    <th>Waktu Keluar</th>
                    <th>Durasi</th>
                    <th>Total Biaya</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% transaksi.forEach(t => { %>
                    <tr>
                        <td><strong><%= t.no_plat %></strong></td>
                        <td><%= t.nama_pemilik %></td>
                        <td><span class="badge bg-info"><%= t.kategori %></span></td>
                        <td><%= t.jenis_kendaraan %></td>
                        <td><%= t.nama_area %></td>
                        <td><%= new Date(t.waktu_masuk).toLocaleString('id-ID') %></td>
                        <td><%= t.waktu_keluar ? new Date(t.waktu_keluar).toLocaleString('id-ID') : '-' %></td>
                        <td><%= t.durasi_jam %> Jam</td>
                        <td>Rp <%= Number(t.total_biaya).toLocaleString('id-ID') %></td>
                        <td>
                            <% if (!t.waktu_keluar) { %>
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#modalKeluar<%= t.id %>">
                                        Proses Keluar
                                    </button>
                                </div>

                                <!-- Modal Simulasi Waktu Keluar -->
                                <div class="modal fade" id="modalKeluar<%= t.id %>" tabindex="-1"
                                     aria-labelledby="modalKeluarLabel<%= t.id %>" aria-hidden="true">
                                    <div class="modal-dialog modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-header py-2">
                                                <h6 class="modal-title" id="modalKeluarLabel<%= t.id %>">
                                                    Simulasi Keluar — <%= t.no_plat %>
                                                </h6>
                                                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Tutup"></button>
                                            </div>
                                            <div class="modal-body">
                                                <form action="/keluar/<%= t.id %>" method="POST">
                                                    <label class="form-label mb-1">Pilih Tanggal Keluar</label>
                                                    <input type="date" name="tanggal_keluar"
                                                           class="form-control form-control-sm mb-2" required
                                                           value="<%= (() => { const d = new Date(t.waktu_masuk); const pad = n => String(n).padStart(2,'0'); return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); })() %>"
                                                           min="<%= (() => { const d = new Date(t.waktu_masuk); const pad = n => String(n).padStart(2,'0'); return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); })() %>">
                                                    <label class="form-label mb-1">Pilih Jam Keluar</label>
                                                    <input type="time" name="jam_keluar"
                                                           class="form-control form-control-sm" required
                                                           value="<%= (() => { const d = new Date(t.waktu_masuk); const pad = n => String(n).padStart(2,'0'); return pad(d.getHours()) + ':' + pad(d.getMinutes()); })() %>">
                                                    <input type="hidden" name="id" value="<%= t.id %>">
                                                    <div class="mt-3 d-flex gap-2">
                                                        <button type="submit" class="btn btn-sm btn-danger flex-fill">
                                                            Proses & Hitung Biaya
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                                                            Batal
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } else { %>
                                <span class="badge bg-secondary">Selesai</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>